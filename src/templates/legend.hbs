<section class="political-overlay-legend-body">
    <ol class="entries">
        {{#each entries}}
        <li class="entry">
            <span class="swatch" style="--swatch: {{color}}"></span>
            {{#if @root.isGM}}
            <input type="text" class="name" name="{{key}}.name" value="{{customName}}" placeholder="{{name}}">
            {{else}}
            <span class="name">{{name}}</span>
            {{/if}}
        </li>
        {{/each}}
    </ol>
    {{#if isGM}}
    <footer class="form-footer">
        <button type="submit"><i class="fa-solid fa-check"></i> {{localize "POLITICAL_OVERLAY.legend.confirm"}}</button>
        <button type="button" data-action="revert"><i class="fa-solid fa-rotate-left"></i> {{localize "POLITICAL_OVERLAY.legend.revert"}}</button>
    </footer>
    {{/if}}
</section>
