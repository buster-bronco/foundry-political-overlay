<section class="political-overlay-config-body">
    <div class="form-group">
        <label>{{localize "POLITICAL_OVERLAY.config.gmAlpha"}}</label>
        <range-picker name="gmAlpha" value="{{gmAlpha}}" min="0" max="1" step="0.05"></range-picker>
    </div>
    <div class="form-group">
        <label>{{localize "POLITICAL_OVERLAY.config.playerAlpha"}}</label>
        <range-picker name="playerAlpha" value="{{playerAlpha}}" min="0" max="1" step="0.05"></range-picker>
    </div>
    <div class="form-group">
        <label>{{localize "POLITICAL_OVERLAY.config.labelsEnabled"}}</label>
        <input type="checkbox" name="labelsEnabled" {{checked labelsEnabled}}>
    </div>
    <div class="form-group">
        <label>{{localize "POLITICAL_OVERLAY.config.labelGap"}}</label>
        <range-picker name="labelGap" value="{{labelGap}}" min="0" max="4" step="1"></range-picker>
        <p class="hint">{{localize "POLITICAL_OVERLAY.config.labelGapHint"}}</p>
    </div>
    <div class="form-group">
        <label>{{localize "POLITICAL_OVERLAY.config.labelMinWidth"}}</label>
        <range-picker name="labelMinWidth" value="{{labelMinWidth}}" min="0" max="400" step="10"></range-picker>
        <p class="hint">{{localize "POLITICAL_OVERLAY.config.labelMinWidthHint"}}</p>
    </div>
</section>
